# ══════════════════════════════════════════════════════════════════
# Shortly — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════════

# ── Flask ─────────────────────────────────────────────────────────
FLASK_ENV=development          # development | production
SECRET_KEY=change-me-to-a-long-random-string-in-production

# ── MongoDB ───────────────────────────────────────────────────────
# Local development (docker-compose):
MONGO_URI=mongodb://localhost:27017/shortly
# MongoDB Atlas (production):
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=shortly

# ── Docker compose only ────────────────────────────────────────────
MONGO_ROOT_USER=admin
MONGO_ROOT_PASS=password       # Change this in production!

# ── Rate limiting ─────────────────────────────────────────────────
# Use memory:// for single-instance dev, redis:// for multi-instance prod.
# REDIS_URL=redis://localhost:6379

# ── App settings ──────────────────────────────────────────────────
SHORT_CODE_LENGTH=6
FORCE_HTTPS=false              # Set to true behind HTTPS proxy
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR

# ── Deployment: Render.com ────────────────────────────────────────
# Set these as environment variables in your Render service:
#   SECRET_KEY, MONGO_URI, MONGO_DB_NAME, FLASK_ENV=production, FORCE_HTTPS=true
